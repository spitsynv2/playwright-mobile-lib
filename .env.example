# Remote session endpoint. Leave this value unset for local browser runs.
#
# Full WebSocket URL including the /sessions path. Platform is selected from
# capabilities.platformName, not from the URL.
PLAYWRIGHT_MOBILE_HUB_URL=

# Put basic-auth credentials in the URL. Percent-encode reserved characters.
# PLAYWRIGHT_MOBILE_HUB_URL="wss://${HUB_USER}:${HUB_PASSWORD}@example.com:7465/sessions"

# Local pre-flight: with no endpoint set, runs launch a local browser and emulate
# the capabilities.deviceName viewport (iOS -> WebKit, Android -> Chromium).

# Connection behavior. The code fallback is 120000 ms.
PLAYWRIGHT_MOBILE_CONNECT_TIMEOUT_MS=180000
PLAYWRIGHT_MOBILE_CLIENT_ID=
PLAYWRIGHT_SLOW_MO_MS=0

# Zebrunner reporting. Set to true to report the farm session to Zebrunner.
# Any other value (or unset) keeps reporting off.
REPORTING_ENABLED=false
